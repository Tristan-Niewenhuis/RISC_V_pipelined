create_hw_axi_txn release_cpu_5 $hw_axi -type WRITE -address C0000014 -data 00000001
run_axi_delayed release_cpu_5

# Poll STATUS until DONE = 1
set done_5 0
set poll_start_5 [clock seconds]
create_hw_axi_txn status_5 $hw_axi -type READ -address C0000010
while {!$done_5} {
    run_hw_axi [get_hw_axi_txns status_5]
    set status_data_5 [get_property DATA [get_hw_axi_txns status_5]]
    scan $status_data_5 %x status_value_5
    if {($status_value_5 & 1) != 0} {
        set done_5 1
    }
    if {[expr {[clock seconds] - $poll_start_5}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on huffbench"
        puts $result_fp "huffbench,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_5 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_5]
set cycle_lo_data_5 [get_property DATA [get_hw_axi_txns cycle_lo_5]]
scan $cycle_lo_data_5 %x cycle_lo_5

# Read cycle_hi
create_hw_axi_txn cycle_hi_5 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_5]
set cycle_hi_data_5 [get_property DATA [get_hw_axi_txns cycle_hi_5]]
scan $cycle_hi_data_5 %x cycle_hi_5

# Read instret_lo
create_hw_axi_txn instret_lo_5 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_5]
set instret_lo_data_5 [get_property DATA [get_hw_axi_txns instret_lo_5]]
scan $instret_lo_data_5 %x instret_lo_5

# Read instret_hi
create_hw_axi_txn instret_hi_5 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_5]
set instret_hi_data_5 [get_property DATA [get_hw_axi_txns instret_hi_5]]
scan $instret_hi_data_5 %x instret_hi_5

# Combine 32-bit halves into 64-bit values
set cycles_5 [expr {($cycle_hi_5 << 32) | $cycle_lo_5}]
set instret_5 [expr {($instret_hi_5 << 32) | $instret_lo_5}]

puts "TEST: huffbench"
puts "  cycles  = $cycles_5"
puts "  instret = $instret_5"
puts $result_fp "huffbench,$cycle_lo_5,$cycle_hi_5,$cycles_5,$instret_lo_5,$instret_hi_5,$instret_5,0"
flush $result_fp

# Put CPU back into reset before next test
create_hw_axi_txn final_reset_5 $hw_axi -type WRITE -address C0000014 -data 00000000
run_axi_delayed final_reset_5

