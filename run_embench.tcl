# Release CPU reset
create_hw_axi_txn release_cpu_15 $hw_axi -type WRITE -address C0000014 -data 00000001
run_axi_delayed release_cpu_15

# Poll STATUS until DONE = 1
set done_15 0
set poll_start_15 [clock seconds]
create_hw_axi_txn status_15 $hw_axi -type READ -address C0000010
while {!$done_15} {
    run_hw_axi [get_hw_axi_txns status_15]
    set status_data_15 [get_property DATA [get_hw_axi_txns status_15]]
    scan $status_data_15 %x status_value_15
    if {($status_value_15 & 1) != 0} {
        set done_15 1
    }
    if {[expr {[clock seconds] - $poll_start_15}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on statemate"
        puts $result_fp "statemate,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_15 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_15]
set cycle_lo_data_15 [get_property DATA [get_hw_axi_txns cycle_lo_15]]
scan $cycle_lo_data_15 %x cycle_lo_15

# Read cycle_hi
create_hw_axi_txn cycle_hi_15 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_15]
set cycle_hi_data_15 [get_property DATA [get_hw_axi_txns cycle_hi_15]]
scan $cycle_hi_data_15 %x cycle_hi_15

# Read instret_lo
create_hw_axi_txn instret_lo_15 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_15]
set instret_lo_data_15 [get_property DATA [get_hw_axi_txns instret_lo_15]]
scan $instret_lo_data_15 %x instret_lo_15

# Read instret_hi
create_hw_axi_txn instret_hi_15 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_15]
set instret_hi_data_15 [get_property DATA [get_hw_axi_txns instret_hi_15]]
scan $instret_hi_data_15 %x instret_hi_15

# Combine 32-bit halves into 64-bit values
set cycles_15 [expr {($cycle_hi_15 << 32) | $cycle_lo_15}]
set instret_15 [expr {($instret_hi_15 << 32) | $instret_lo_15}]

puts "TEST: statemate"
puts "  cycles  = $cycles_15"
puts "  instret = $instret_15"
puts $result_fp "statemate,$cycle_lo_15,$cycle_hi_15,$cycles_15,$instret_lo_15,$instret_hi_15,$instret_15,0"
flush $result_fp

# Put CPU back into reset before next test
create_hw_axi_txn final_reset_15 $hw_axi -type WRITE -address C0000014 -data 00000000
run_axi_delayed final_reset_15

