create_hw_axi_txn release_cpu_14 $hw_axi -type WRITE -address C0000014 -data 00000001
run_axi_delayed release_cpu_14

# Poll STATUS until DONE = 1
set done_14 0
set poll_start_14 [clock seconds]
create_hw_axi_txn status_14 $hw_axi -type READ -address C0000010
while {!$done_14} {
    run_hw_axi [get_hw_axi_txns status_14]
    set status_data_14 [get_property DATA [get_hw_axi_txns status_14]]
    scan $status_data_14 %x status_value_14
    if {($status_value_14 & 1) != 0} {
        set done_14 1
    }
    if {[expr {[clock seconds] - $poll_start_14}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on slre"
        puts $result_fp "slre,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_14 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_14]
set cycle_lo_data_14 [get_property DATA [get_hw_axi_txns cycle_lo_14]]
scan $cycle_lo_data_14 %x cycle_lo_14

# Read cycle_hi
create_hw_axi_txn cycle_hi_14 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_14]
set cycle_hi_data_14 [get_property DATA [get_hw_axi_txns cycle_hi_14]]
scan $cycle_hi_data_14 %x cycle_hi_14

# Read instret_lo
create_hw_axi_txn instret_lo_14 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_14]
set instret_lo_data_14 [get_property DATA [get_hw_axi_txns instret_lo_14]]
scan $instret_lo_data_14 %x instret_lo_14

# Read instret_hi
create_hw_axi_txn instret_hi_14 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_14]
set instret_hi_data_14 [get_property DATA [get_hw_axi_txns instret_hi_14]]
scan $instret_hi_data_14 %x instret_hi_14

# Combine 32-bit halves into 64-bit values
set cycles_14 [expr {($cycle_hi_14 << 32) | $cycle_lo_14}]
set instret_14 [expr {($instret_hi_14 << 32) | $instret_lo_14}]

puts "TEST: slre"
puts "  cycles  = $cycles_14"
puts "  instret = $instret_14"
puts $result_fp "slre,$cycle_lo_14,$cycle_hi_14,$cycles_14,$instret_lo_14,$instret_hi_14,$instret_14,0"
flush $result_fp

