run_axi_delayed release_cpu_13

# Poll STATUS until DONE = 1
set done_13 0
set poll_start_13 [clock seconds]
create_hw_axi_txn status_13 $hw_axi -type READ -address C0000010
while {!$done_13} {
    run_hw_axi [get_hw_axi_txns status_13]
    set status_data_13 [get_property DATA [get_hw_axi_txns status_13]]
    scan $status_data_13 %x status_value_13
    if {($status_value_13 & 1) != 0} {
        set done_13 1
    }
    if {[expr {[clock seconds] - $poll_start_13}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on sglib-combined"
        puts $result_fp "sglib-combined,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_13 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_13]
set cycle_lo_data_13 [get_property DATA [get_hw_axi_txns cycle_lo_13]]
scan $cycle_lo_data_13 %x cycle_lo_13

# Read cycle_hi
create_hw_axi_txn cycle_hi_13 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_13]
set cycle_hi_data_13 [get_property DATA [get_hw_axi_txns cycle_hi_13]]
scan $cycle_hi_data_13 %x cycle_hi_13

# Read instret_lo
create_hw_axi_txn instret_lo_13 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_13]
set instret_lo_data_13 [get_property DATA [get_hw_axi_txns instret_lo_13]]
scan $instret_lo_data_13 %x instret_lo_13

# Read instret_hi
create_hw_axi_txn instret_hi_13 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_13]
set instret_hi_data_13 [get_property DATA [get_hw_axi_txns instret_hi_13]]
scan $instret_hi_data_13 %x instret_hi_13

# Combine 32-bit halves into 64-bit values
set cycles_13 [expr {($cycle_hi_13 << 32) | $cycle_lo_13}]
set instret_13 [expr {($instret_hi_13 << 32) | $instret_lo_13}]

puts "TEST: sglib-combined"
puts "  cycles  = $cycles_13"
puts "  instret = $instret_13"
puts $result_fp "sglib-combined,$cycle_lo_13,$cycle_hi_13,$cycles_13,$instret_lo_13,$instret_hi_13,$instret_13,0"
flush $result_fp

# Put CPU back into reset before next test
