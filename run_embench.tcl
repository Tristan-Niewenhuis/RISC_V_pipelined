# Poll STATUS until DONE = 1
set done_17 0
set poll_start_17 [clock seconds]
create_hw_axi_txn status_17 $hw_axi -type READ -address C0000010
while {!$done_17} {
    run_hw_axi [get_hw_axi_txns status_17]
    set status_data_17 [get_property DATA [get_hw_axi_txns status_17]]
    scan $status_data_17 %x status_value_17
    if {($status_value_17 & 1) != 0} {
        set done_17 1
    }
    if {[expr {[clock seconds] - $poll_start_17}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on ud"
        puts $result_fp "ud,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_17 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_17]
set cycle_lo_data_17 [get_property DATA [get_hw_axi_txns cycle_lo_17]]
scan $cycle_lo_data_17 %x cycle_lo_17

# Read cycle_hi
create_hw_axi_txn cycle_hi_17 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_17]
set cycle_hi_data_17 [get_property DATA [get_hw_axi_txns cycle_hi_17]]
scan $cycle_hi_data_17 %x cycle_hi_17

# Read instret_lo
create_hw_axi_txn instret_lo_17 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_17]
set instret_lo_data_17 [get_property DATA [get_hw_axi_txns instret_lo_17]]
scan $instret_lo_data_17 %x instret_lo_17

# Read instret_hi
create_hw_axi_txn instret_hi_17 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_17]
set instret_hi_data_17 [get_property DATA [get_hw_axi_txns instret_hi_17]]
scan $instret_hi_data_17 %x instret_hi_17

# Combine 32-bit halves into 64-bit values
set cycles_17 [expr {($cycle_hi_17 << 32) | $cycle_lo_17}]
set instret_17 [expr {($instret_hi_17 << 32) | $instret_lo_17}]

puts "TEST: ud"
puts "  cycles  = $cycles_17"
puts "  instret = $instret_17"
puts $result_fp "ud,$cycle_lo_17,$cycle_hi_17,$cycles_17,$instret_lo_17,$instret_hi_17,$instret_17,0"
flush $result_fp

# Put CPU back into reset before next test
