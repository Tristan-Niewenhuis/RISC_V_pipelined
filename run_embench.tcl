# ============================================================
# Automatically generated by run_embench.py
# ============================================================

open_hw_manager
connect_hw_server
open_hw_target
set hw_device [lindex [get_hw_devices] 0]
refresh_hw_device $hw_device

# Locate JTAG-to-AXI Master
set hw_axi [get_hw_axis hw_axi_1]

# Reset JTAG-to-AXI Master
reset_hw_axi $hw_axi

set result_file "C:/RISC_V_research/RISC_V_pipelined_private/embench_results.csv"
set result_fp [open $result_file "w"]
puts $result_fp "name,cycle_low,cycle_high,cycles,instret_low,instret_high,instret,elapsed_seconds"

# ============================================================
# TEST 0: empty_test
# ============================================================

# Assert CPU reset
create_hw_axi_txn reset_cpu_0 $hw_axi -type WRITE -address C0000014 -data 00000000
run_hw_axi [get_hw_axi_txns reset_cpu_0]

# Load IRAM

# ------------------------------------------------------------
# Write 100 words at 00000000
# ------------------------------------------------------------

delete_hw_axi_txn -quiet [{
    get_hw_axi_txns iram_0_0
}]

create_hw_axi_txn iram_0_0 [get_hw_axis hw_axi_1] \
    -type WRITE \
    -address 00000000 \
    -len 100 \
    -data {00020117_FE010113_00010297_FF828293_00010317_01030313_0062D863_0002A023_00428293_FF5FF06F_034000EF_0000006F_00008067_00008067_06400793_00000013_FFF78793_FE079CE3_0BE00513_00008067_F4250513_00153513_00008067_FE010113_00112E23_038000EF_FC9FF0EF_00100513_FC5FF0EF_030000EF_FC1FF0EF_00A12623_058000EF_00C12503_FC9FF0EF_01C12083_00153513_02010113_00008067_00000513_00008067_C0002773_000107B7_00E7AC23_C8002773_000107B7_00E7AE23_C0202773_000107B7_00E7A423_C8202773_000107B7_00E7A623_00008067_C00027F3_00010637_00F62823_C80027F3_00010737_00F72A23_C02027F3_000106B7_00F6A023_C82025F3_000107B7_00B7A223_000105B7_01C5AE03_000105B7_0185A503_01472703_01062583_00010637_00C62303_00010637_00862603_0047A783_0006A683_40A58533_00A5B5B3_000108B7_41C70733_FEA8A023_40B70733_40C68633_00010837_FEE82223_00010537_00C6B6B3_406787B3_FEC52423_40D787B3_000105B7_FEF5A623_00010737_00100793_FEF72823_00000013_00000013_FF9FF06F}

run_hw_axi [get_hw_axi_txns iram_0_0]


# Load DRAM


# Release CPU reset
create_hw_axi_txn release_cpu_0 $hw_axi -type WRITE -address C0000014 -data 00000001
run_hw_axi [get_hw_axi_txns release_cpu_0]

# Poll STATUS until DONE = 1
set done_0 0
set poll_start_0 [clock seconds]
while {!$done_0} {
    create_hw_axi_txn status_0 $hw_axi -type READ -address C0000010
    run_hw_axi [get_hw_axi_txns status_0]
    set status_data_0 [get_property DATA [get_hw_axi_txns status_0]]
    set status_value_0 [expr {0x$status_data_0}]
    if {($status_value_0 & 1) != 0} {
        set done_0 1
    }
    if {[expr {[clock seconds] - $poll_start_0}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on empty_test"
        puts $result_fp "empty_test,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle low
create_hw_axi_txn cycle_lo_0 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_0]
set cycle_lo_0 [expr {0x[get_property DATA [get_hw_axi_txns cycle_lo_0]]}]

# Read cycle high
create_hw_axi_txn cycle_hi_0 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_0]
set cycle_hi_0 [expr {0x[get_property DATA [get_hw_axi_txns cycle_hi_0]]}]

# Read retired instructions low
create_hw_axi_txn instret_lo_0 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_0]
set instret_lo_0 [expr {0x[get_property DATA [get_hw_axi_txns instret_lo_0]]}]

# Read retired instructions high
create_hw_axi_txn instret_hi_0 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_0]
set instret_hi_0 [expr {0x[get_property DATA [get_hw_axi_txns instret_hi_0]]}]

# Combine 32-bit halves into 64-bit values
set cycles_0 [expr {($cycle_hi_0 << 32) | $cycle_lo_0}]
set instret_0 [expr {($instret_hi_0 << 32) | $instret_lo_0}]

puts "TEST: empty_test"
puts "  cycles  = $cycles_0"
puts "  instret = $instret_0"
puts $result_fp "empty_test,$cycle_lo_0,$cycle_hi_0,$cycles_0,$instret_lo_0,$instret_hi_0,$instret_0,0"
flush $result_fp

# Put CPU back into reset before next test
create_hw_axi_txn final_reset_0 $hw_axi -type WRITE -address C0000014 -data 00000000
run_hw_axi [get_hw_axi_txns final_reset_0]

