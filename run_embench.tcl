create_hw_axi_txn release_cpu_11 $hw_axi -type WRITE -address C0000014 -data 00000001
run_axi_delayed release_cpu_11

# Poll STATUS until DONE = 1
set done_11 0
set poll_start_11 [clock seconds]
create_hw_axi_txn status_11 $hw_axi -type READ -address C0000010
while {!$done_11} {
    run_hw_axi [get_hw_axi_txns status_11]
    set status_data_11 [get_property DATA [get_hw_axi_txns status_11]]
    scan $status_data_11 %x status_value_11
    if {($status_value_11 & 1) != 0} {
        set done_11 1
    }
    if {[expr {[clock seconds] - $poll_start_11}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on picojpeg"
        puts $result_fp "picojpeg,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_11 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_11]
set cycle_lo_data_11 [get_property DATA [get_hw_axi_txns cycle_lo_11]]
scan $cycle_lo_data_11 %x cycle_lo_11

# Read cycle_hi
create_hw_axi_txn cycle_hi_11 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_11]
set cycle_hi_data_11 [get_property DATA [get_hw_axi_txns cycle_hi_11]]
scan $cycle_hi_data_11 %x cycle_hi_11

# Read instret_lo
create_hw_axi_txn instret_lo_11 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_11]
set instret_lo_data_11 [get_property DATA [get_hw_axi_txns instret_lo_11]]
scan $instret_lo_data_11 %x instret_lo_11

# Read instret_hi
create_hw_axi_txn instret_hi_11 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_11]
set instret_hi_data_11 [get_property DATA [get_hw_axi_txns instret_hi_11]]
scan $instret_hi_data_11 %x instret_hi_11

# Combine 32-bit halves into 64-bit values
set cycles_11 [expr {($cycle_hi_11 << 32) | $cycle_lo_11}]
set instret_11 [expr {($instret_hi_11 << 32) | $instret_lo_11}]

puts "TEST: picojpeg"
puts "  cycles  = $cycles_11"
puts "  instret = $instret_11"
puts $result_fp "picojpeg,$cycle_lo_11,$cycle_hi_11,$cycles_11,$instret_lo_11,$instret_hi_11,$instret_11,0"
flush $result_fp

# Put CPU back into reset before next test
