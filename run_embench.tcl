run_axi_delayed release_cpu_12

# Poll STATUS until DONE = 1
set done_12 0
set poll_start_12 [clock seconds]
create_hw_axi_txn status_12 $hw_axi -type READ -address C0000010
while {!$done_12} {
    run_hw_axi [get_hw_axi_txns status_12]
    set status_data_12 [get_property DATA [get_hw_axi_txns status_12]]
    scan $status_data_12 %x status_value_12
    if {($status_value_12 & 1) != 0} {
        set done_12 1
    }
    if {[expr {[clock seconds] - $poll_start_12}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on qrduino"
        puts $result_fp "qrduino,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_12 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_12]
set cycle_lo_data_12 [get_property DATA [get_hw_axi_txns cycle_lo_12]]
scan $cycle_lo_data_12 %x cycle_lo_12

# Read cycle_hi
create_hw_axi_txn cycle_hi_12 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_12]
set cycle_hi_data_12 [get_property DATA [get_hw_axi_txns cycle_hi_12]]
scan $cycle_hi_data_12 %x cycle_hi_12

# Read instret_lo
create_hw_axi_txn instret_lo_12 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_12]
set instret_lo_data_12 [get_property DATA [get_hw_axi_txns instret_lo_12]]
scan $instret_lo_data_12 %x instret_lo_12

# Read instret_hi
create_hw_axi_txn instret_hi_12 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_12]
set instret_hi_data_12 [get_property DATA [get_hw_axi_txns instret_hi_12]]
scan $instret_hi_data_12 %x instret_hi_12

# Combine 32-bit halves into 64-bit values
set cycles_12 [expr {($cycle_hi_12 << 32) | $cycle_lo_12}]
set instret_12 [expr {($instret_hi_12 << 32) | $instret_lo_12}]

puts "TEST: qrduino"
puts "  cycles  = $cycles_12"
puts "  instret = $instret_12"
puts $result_fp "qrduino,$cycle_lo_12,$cycle_hi_12,$cycles_12,$instret_lo_12,$instret_hi_12,$instret_12,0"
flush $result_fp

# Put CPU back into reset before next test
create_hw_axi_txn final_reset_12 $hw_axi -type WRITE -address C0000014 -data 00000000
run_axi_delayed final_reset_12

