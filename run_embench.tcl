# Release CPU reset
create_hw_axi_txn release_cpu_4 $hw_axi -type WRITE -address C0000014 -data 00000001
run_axi_delayed release_cpu_4

# Poll STATUS until DONE = 1
set done_4 0
set poll_start_4 [clock seconds]
create_hw_axi_txn status_4 $hw_axi -type READ -address C0000010
while {!$done_4} {
    run_hw_axi [get_hw_axi_txns status_4]
    set status_data_4 [get_property DATA [get_hw_axi_txns status_4]]
    scan $status_data_4 %x status_value_4
    if {($status_value_4 & 1) != 0} {
        set done_4 1
    }
    if {[expr {[clock seconds] - $poll_start_4}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on fake_test"
        puts $result_fp "fake_test,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_4 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_4]
set cycle_lo_data_4 [get_property DATA [get_hw_axi_txns cycle_lo_4]]
scan $cycle_lo_data_4 %x cycle_lo_4

# Read cycle_hi
create_hw_axi_txn cycle_hi_4 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_4]
set cycle_hi_data_4 [get_property DATA [get_hw_axi_txns cycle_hi_4]]
scan $cycle_hi_data_4 %x cycle_hi_4

# Read instret_lo
create_hw_axi_txn instret_lo_4 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_4]
set instret_lo_data_4 [get_property DATA [get_hw_axi_txns instret_lo_4]]
scan $instret_lo_data_4 %x instret_lo_4

# Read instret_hi
create_hw_axi_txn instret_hi_4 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_4]
set instret_hi_data_4 [get_property DATA [get_hw_axi_txns instret_hi_4]]
scan $instret_hi_data_4 %x instret_hi_4

# Combine 32-bit halves into 64-bit values
set cycles_4 [expr {($cycle_hi_4 << 32) | $cycle_lo_4}]
set instret_4 [expr {($instret_hi_4 << 32) | $instret_lo_4}]

puts "TEST: fake_test"
puts "  cycles  = $cycles_4"
puts "  instret = $instret_4"
puts $result_fp "fake_test,$cycle_lo_4,$cycle_hi_4,$cycles_4,$instret_lo_4,$instret_hi_4,$instret_4,0"
flush $result_fp

# Put CPU back into reset before next test
create_hw_axi_txn final_reset_4 $hw_axi -type WRITE -address C0000014 -data 00000000
run_axi_delayed final_reset_4

