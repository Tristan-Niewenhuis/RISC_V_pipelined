create_hw_axi_txn release_cpu_6 $hw_axi -type WRITE -address C0000014 -data 00000001
run_axi_delayed release_cpu_6

# Poll STATUS until DONE = 1
set done_6 0
set poll_start_6 [clock seconds]
create_hw_axi_txn status_6 $hw_axi -type READ -address C0000010
while {!$done_6} {
    run_hw_axi [get_hw_axi_txns status_6]
    set status_data_6 [get_property DATA [get_hw_axi_txns status_6]]
    scan $status_data_6 %x status_value_6
    if {($status_value_6 & 1) != 0} {
        set done_6 1
    }
    if {[expr {[clock seconds] - $poll_start_6}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on matmult-int"
        puts $result_fp "matmult-int,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_6 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_6]
set cycle_lo_data_6 [get_property DATA [get_hw_axi_txns cycle_lo_6]]
scan $cycle_lo_data_6 %x cycle_lo_6

# Read cycle_hi
create_hw_axi_txn cycle_hi_6 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_6]
set cycle_hi_data_6 [get_property DATA [get_hw_axi_txns cycle_hi_6]]
scan $cycle_hi_data_6 %x cycle_hi_6

# Read instret_lo
create_hw_axi_txn instret_lo_6 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_6]
set instret_lo_data_6 [get_property DATA [get_hw_axi_txns instret_lo_6]]
scan $instret_lo_data_6 %x instret_lo_6

# Read instret_hi
create_hw_axi_txn instret_hi_6 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_6]
set instret_hi_data_6 [get_property DATA [get_hw_axi_txns instret_hi_6]]
scan $instret_hi_data_6 %x instret_hi_6

# Combine 32-bit halves into 64-bit values
set cycles_6 [expr {($cycle_hi_6 << 32) | $cycle_lo_6}]
set instret_6 [expr {($instret_hi_6 << 32) | $instret_lo_6}]

puts "TEST: matmult-int"
puts "  cycles  = $cycles_6"
puts "  instret = $instret_6"
puts $result_fp "matmult-int,$cycle_lo_6,$cycle_hi_6,$cycles_6,$instret_lo_6,$instret_hi_6,$instret_6,0"
flush $result_fp

# Put CPU back into reset before next test
