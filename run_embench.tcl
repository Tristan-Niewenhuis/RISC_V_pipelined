# Load DRAM (one AXI transaction per 32-bit word)


# Release CPU reset
create_hw_axi_txn release_cpu_10 $hw_axi -type WRITE -address C0000014 -data 00000001
run_axi_delayed release_cpu_10

# Poll STATUS until DONE = 1
set done_10 0
set poll_start_10 [clock seconds]
create_hw_axi_txn status_10 $hw_axi -type READ -address C0000010
while {!$done_10} {
    run_hw_axi [get_hw_axi_txns status_10]
    set status_data_10 [get_property DATA [get_hw_axi_txns status_10]]
    scan $status_data_10 %x status_value_10
    if {($status_value_10 & 1) != 0} {
        set done_10 1
    }
    if {[expr {[clock seconds] - $poll_start_10}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on nsichneu"
        puts $result_fp "nsichneu,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_10 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_10]
set cycle_lo_data_10 [get_property DATA [get_hw_axi_txns cycle_lo_10]]
scan $cycle_lo_data_10 %x cycle_lo_10

# Read cycle_hi
create_hw_axi_txn cycle_hi_10 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_10]
set cycle_hi_data_10 [get_property DATA [get_hw_axi_txns cycle_hi_10]]
scan $cycle_hi_data_10 %x cycle_hi_10

# Read instret_lo
create_hw_axi_txn instret_lo_10 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_10]
set instret_lo_data_10 [get_property DATA [get_hw_axi_txns instret_lo_10]]
scan $instret_lo_data_10 %x instret_lo_10

# Read instret_hi
create_hw_axi_txn instret_hi_10 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_10]
set instret_hi_data_10 [get_property DATA [get_hw_axi_txns instret_hi_10]]
scan $instret_hi_data_10 %x instret_hi_10

# Combine 32-bit halves into 64-bit values
set cycles_10 [expr {($cycle_hi_10 << 32) | $cycle_lo_10}]
set instret_10 [expr {($instret_hi_10 << 32) | $instret_lo_10}]

puts "TEST: nsichneu"
puts "  cycles  = $cycles_10"
puts "  instret = $instret_10"
puts $result_fp "nsichneu,$cycle_lo_10,$cycle_hi_10,$cycles_10,$instret_lo_10,$instret_hi_10,$instret_10,0"
flush $result_fp

