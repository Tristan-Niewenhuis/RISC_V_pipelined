create_hw_axi_txn release_cpu_19 $hw_axi -type WRITE -address C0000014 -data 00000001
run_axi_delayed release_cpu_19

# Poll STATUS until DONE = 1
set done_19 0
set poll_start_19 [clock seconds]
create_hw_axi_txn status_19 $hw_axi -type READ -address C0000010
while {!$done_19} {
    run_hw_axi [get_hw_axi_txns status_19]
    set status_data_19 [get_property DATA [get_hw_axi_txns status_19]]
    scan $status_data_19 %x status_value_19
    if {($status_value_19 & 1) != 0} {
        set done_19 1
    }
    if {[expr {[clock seconds] - $poll_start_19}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on xgboost"
        puts $result_fp "xgboost,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_19 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_19]
set cycle_lo_data_19 [get_property DATA [get_hw_axi_txns cycle_lo_19]]
scan $cycle_lo_data_19 %x cycle_lo_19

# Read cycle_hi
create_hw_axi_txn cycle_hi_19 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_19]
set cycle_hi_data_19 [get_property DATA [get_hw_axi_txns cycle_hi_19]]
scan $cycle_hi_data_19 %x cycle_hi_19

# Read instret_lo
create_hw_axi_txn instret_lo_19 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_19]
set instret_lo_data_19 [get_property DATA [get_hw_axi_txns instret_lo_19]]
scan $instret_lo_data_19 %x instret_lo_19

# Read instret_hi
create_hw_axi_txn instret_hi_19 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_19]
set instret_hi_data_19 [get_property DATA [get_hw_axi_txns instret_hi_19]]
scan $instret_hi_data_19 %x instret_hi_19

# Combine 32-bit halves into 64-bit values
set cycles_19 [expr {($cycle_hi_19 << 32) | $cycle_lo_19}]
set instret_19 [expr {($instret_hi_19 << 32) | $instret_lo_19}]

puts "TEST: xgboost"
puts "  cycles  = $cycles_19"
puts "  instret = $instret_19"
puts $result_fp "xgboost,$cycle_lo_19,$cycle_hi_19,$cycles_19,$instret_lo_19,$instret_hi_19,$instret_19,0"
flush $result_fp

# Put CPU back into reset before next test
create_hw_axi_txn final_reset_19 $hw_axi -type WRITE -address C0000014 -data 00000000
run_axi_delayed final_reset_19

close $result_fp
close_hw_target
disconnect_hw_server
close_hw_manager
exit
