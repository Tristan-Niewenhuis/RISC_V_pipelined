create_hw_axi_txn release_cpu_2 $hw_axi -type WRITE -address C0000014 -data 00000001
run_axi_delayed release_cpu_2

# Poll STATUS until DONE = 1
set done_2 0
set poll_start_2 [clock seconds]
create_hw_axi_txn status_2 $hw_axi -type READ -address C0000010
while {!$done_2} {
    run_hw_axi [get_hw_axi_txns status_2]
    set status_data_2 [get_property DATA [get_hw_axi_txns status_2]]
    scan $status_data_2 %x status_value_2
    if {($status_value_2 & 1) != 0} {
        set done_2 1
    }
    if {[expr {[clock seconds] - $poll_start_2}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on depthconv"
        puts $result_fp "depthconv,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_2 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_2]
set cycle_lo_data_2 [get_property DATA [get_hw_axi_txns cycle_lo_2]]
scan $cycle_lo_data_2 %x cycle_lo_2

# Read cycle_hi
create_hw_axi_txn cycle_hi_2 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_2]
set cycle_hi_data_2 [get_property DATA [get_hw_axi_txns cycle_hi_2]]
scan $cycle_hi_data_2 %x cycle_hi_2

# Read instret_lo
create_hw_axi_txn instret_lo_2 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_2]
set instret_lo_data_2 [get_property DATA [get_hw_axi_txns instret_lo_2]]
scan $instret_lo_data_2 %x instret_lo_2

# Read instret_hi
create_hw_axi_txn instret_hi_2 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_2]
set instret_hi_data_2 [get_property DATA [get_hw_axi_txns instret_hi_2]]
scan $instret_hi_data_2 %x instret_hi_2

# Combine 32-bit halves into 64-bit values
set cycles_2 [expr {($cycle_hi_2 << 32) | $cycle_lo_2}]
set instret_2 [expr {($instret_hi_2 << 32) | $instret_lo_2}]

puts "TEST: depthconv"
puts "  cycles  = $cycles_2"
puts "  instret = $instret_2"
puts $result_fp "depthconv,$cycle_lo_2,$cycle_hi_2,$cycles_2,$instret_lo_2,$instret_hi_2,$instret_2,0"
flush $result_fp

# Put CPU back into reset before next test
