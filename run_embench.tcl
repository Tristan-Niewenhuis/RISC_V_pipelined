run_axi_delayed release_cpu_9

# Poll STATUS until DONE = 1
set done_9 0
set poll_start_9 [clock seconds]
create_hw_axi_txn status_9 $hw_axi -type READ -address C0000010
while {!$done_9} {
    run_hw_axi [get_hw_axi_txns status_9]
    set status_data_9 [get_property DATA [get_hw_axi_txns status_9]]
    scan $status_data_9 %x status_value_9
    if {($status_value_9 & 1) != 0} {
        set done_9 1
    }
    if {[expr {[clock seconds] - $poll_start_9}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on nettle-sha256"
        puts $result_fp "nettle-sha256,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_9 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_9]
set cycle_lo_data_9 [get_property DATA [get_hw_axi_txns cycle_lo_9]]
scan $cycle_lo_data_9 %x cycle_lo_9

# Read cycle_hi
create_hw_axi_txn cycle_hi_9 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_9]
set cycle_hi_data_9 [get_property DATA [get_hw_axi_txns cycle_hi_9]]
scan $cycle_hi_data_9 %x cycle_hi_9

# Read instret_lo
create_hw_axi_txn instret_lo_9 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_9]
set instret_lo_data_9 [get_property DATA [get_hw_axi_txns instret_lo_9]]
scan $instret_lo_data_9 %x instret_lo_9

# Read instret_hi
create_hw_axi_txn instret_hi_9 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_9]
set instret_hi_data_9 [get_property DATA [get_hw_axi_txns instret_hi_9]]
scan $instret_hi_data_9 %x instret_hi_9

# Combine 32-bit halves into 64-bit values
set cycles_9 [expr {($cycle_hi_9 << 32) | $cycle_lo_9}]
set instret_9 [expr {($instret_hi_9 << 32) | $instret_lo_9}]

puts "TEST: nettle-sha256"
puts "  cycles  = $cycles_9"
puts "  instret = $instret_9"
puts $result_fp "nettle-sha256,$cycle_lo_9,$cycle_hi_9,$cycles_9,$instret_lo_9,$instret_hi_9,$instret_9,0"
flush $result_fp

# Put CPU back into reset before next test
