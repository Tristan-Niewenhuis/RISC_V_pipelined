# Release CPU reset
create_hw_axi_txn release_cpu_16 $hw_axi -type WRITE -address C0000014 -data 00000001
run_axi_delayed release_cpu_16

# Poll STATUS until DONE = 1
set done_16 0
set poll_start_16 [clock seconds]
create_hw_axi_txn status_16 $hw_axi -type READ -address C0000010
while {!$done_16} {
    run_hw_axi [get_hw_axi_txns status_16]
    set status_data_16 [get_property DATA [get_hw_axi_txns status_16]]
    scan $status_data_16 %x status_value_16
    if {($status_value_16 & 1) != 0} {
        set done_16 1
    }
    if {[expr {[clock seconds] - $poll_start_16}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on tarfind"
        puts $result_fp "tarfind,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_16 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_16]
set cycle_lo_data_16 [get_property DATA [get_hw_axi_txns cycle_lo_16]]
scan $cycle_lo_data_16 %x cycle_lo_16

# Read cycle_hi
create_hw_axi_txn cycle_hi_16 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_16]
set cycle_hi_data_16 [get_property DATA [get_hw_axi_txns cycle_hi_16]]
scan $cycle_hi_data_16 %x cycle_hi_16

# Read instret_lo
create_hw_axi_txn instret_lo_16 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_16]
set instret_lo_data_16 [get_property DATA [get_hw_axi_txns instret_lo_16]]
scan $instret_lo_data_16 %x instret_lo_16

# Read instret_hi
create_hw_axi_txn instret_hi_16 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_16]
set instret_hi_data_16 [get_property DATA [get_hw_axi_txns instret_hi_16]]
scan $instret_hi_data_16 %x instret_hi_16

# Combine 32-bit halves into 64-bit values
set cycles_16 [expr {($cycle_hi_16 << 32) | $cycle_lo_16}]
set instret_16 [expr {($instret_hi_16 << 32) | $instret_lo_16}]

puts "TEST: tarfind"
puts "  cycles  = $cycles_16"
puts "  instret = $instret_16"
puts $result_fp "tarfind,$cycle_lo_16,$cycle_hi_16,$cycles_16,$instret_lo_16,$instret_hi_16,$instret_16,0"
flush $result_fp

# Put CPU back into reset before next test
create_hw_axi_txn final_reset_16 $hw_axi -type WRITE -address C0000014 -data 00000000
run_axi_delayed final_reset_16

