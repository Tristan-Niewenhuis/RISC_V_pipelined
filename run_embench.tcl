run_axi_delayed release_cpu_8

# Poll STATUS until DONE = 1
set done_8 0
set poll_start_8 [clock seconds]
create_hw_axi_txn status_8 $hw_axi -type READ -address C0000010
while {!$done_8} {
    run_hw_axi [get_hw_axi_txns status_8]
    set status_data_8 [get_property DATA [get_hw_axi_txns status_8]]
    scan $status_data_8 %x status_value_8
    if {($status_value_8 & 1) != 0} {
        set done_8 1
    }
    if {[expr {[clock seconds] - $poll_start_8}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on nettle-aes"
        puts $result_fp "nettle-aes,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_8 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_8]
set cycle_lo_data_8 [get_property DATA [get_hw_axi_txns cycle_lo_8]]
scan $cycle_lo_data_8 %x cycle_lo_8

# Read cycle_hi
create_hw_axi_txn cycle_hi_8 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_8]
set cycle_hi_data_8 [get_property DATA [get_hw_axi_txns cycle_hi_8]]
scan $cycle_hi_data_8 %x cycle_hi_8

# Read instret_lo
create_hw_axi_txn instret_lo_8 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_8]
set instret_lo_data_8 [get_property DATA [get_hw_axi_txns instret_lo_8]]
scan $instret_lo_data_8 %x instret_lo_8

# Read instret_hi
create_hw_axi_txn instret_hi_8 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_8]
set instret_hi_data_8 [get_property DATA [get_hw_axi_txns instret_hi_8]]
scan $instret_hi_data_8 %x instret_hi_8

# Combine 32-bit halves into 64-bit values
set cycles_8 [expr {($cycle_hi_8 << 32) | $cycle_lo_8}]
set instret_8 [expr {($instret_hi_8 << 32) | $instret_lo_8}]

puts "TEST: nettle-aes"
puts "  cycles  = $cycles_8"
puts "  instret = $instret_8"
puts $result_fp "nettle-aes,$cycle_lo_8,$cycle_hi_8,$cycles_8,$instret_lo_8,$instret_hi_8,$instret_8,0"
flush $result_fp

# Put CPU back into reset before next test
create_hw_axi_txn final_reset_8 $hw_axi -type WRITE -address C0000014 -data 00000000
run_axi_delayed final_reset_8

