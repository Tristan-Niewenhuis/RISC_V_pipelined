create_hw_axi_txn release_cpu_3 $hw_axi -type WRITE -address C0000014 -data 00000001
run_axi_delayed release_cpu_3

# Poll STATUS until DONE = 1
set done_3 0
set poll_start_3 [clock seconds]
create_hw_axi_txn status_3 $hw_axi -type READ -address C0000010
while {!$done_3} {
    run_hw_axi [get_hw_axi_txns status_3]
    set status_data_3 [get_property DATA [get_hw_axi_txns status_3]]
    scan $status_data_3 %x status_value_3
    if {($status_value_3 & 1) != 0} {
        set done_3 1
    }
    if {[expr {[clock seconds] - $poll_start_3}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on edn"
        puts $result_fp "edn,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_3 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_3]
set cycle_lo_data_3 [get_property DATA [get_hw_axi_txns cycle_lo_3]]
scan $cycle_lo_data_3 %x cycle_lo_3

# Read cycle_hi
create_hw_axi_txn cycle_hi_3 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_3]
set cycle_hi_data_3 [get_property DATA [get_hw_axi_txns cycle_hi_3]]
scan $cycle_hi_data_3 %x cycle_hi_3

# Read instret_lo
create_hw_axi_txn instret_lo_3 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_3]
set instret_lo_data_3 [get_property DATA [get_hw_axi_txns instret_lo_3]]
scan $instret_lo_data_3 %x instret_lo_3

# Read instret_hi
create_hw_axi_txn instret_hi_3 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_3]
set instret_hi_data_3 [get_property DATA [get_hw_axi_txns instret_hi_3]]
scan $instret_hi_data_3 %x instret_hi_3

# Combine 32-bit halves into 64-bit values
set cycles_3 [expr {($cycle_hi_3 << 32) | $cycle_lo_3}]
set instret_3 [expr {($instret_hi_3 << 32) | $instret_lo_3}]

puts "TEST: edn"
puts "  cycles  = $cycles_3"
puts "  instret = $instret_3"
puts $result_fp "edn,$cycle_lo_3,$cycle_hi_3,$cycles_3,$instret_lo_3,$instret_hi_3,$instret_3,0"
flush $result_fp

# Put CPU back into reset before next test
create_hw_axi_txn final_reset_3 $hw_axi -type WRITE -address C0000014 -data 00000000
run_axi_delayed final_reset_3

