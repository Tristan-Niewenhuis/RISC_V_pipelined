create_hw_axi_txn dram_18_965 $hw_axi \
    -type WRITE \
    -address 80000F14 \
    -len 1 \
    -data {00000000}
run_axi_delayed dram_18_965
delete_hw_axi_txn -quiet [get_hw_axi_txns dram_18_965]


# Release CPU reset
create_hw_axi_txn release_cpu_18 $hw_axi -type WRITE -address C0000014 -data 00000001
run_axi_delayed release_cpu_18

# Poll STATUS until DONE = 1
set done_18 0
set poll_start_18 [clock seconds]
create_hw_axi_txn status_18 $hw_axi -type READ -address C0000010
while {!$done_18} {
    run_hw_axi [get_hw_axi_txns status_18]
    set status_data_18 [get_property DATA [get_hw_axi_txns status_18]]
    scan $status_data_18 %x status_value_18
    if {($status_value_18 & 1) != 0} {
        set done_18 1
    }
    if {[expr {[clock seconds] - $poll_start_18}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on wikisort"
        puts $result_fp "wikisort,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_18 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_18]
set cycle_lo_data_18 [get_property DATA [get_hw_axi_txns cycle_lo_18]]
scan $cycle_lo_data_18 %x cycle_lo_18

# Read cycle_hi
create_hw_axi_txn cycle_hi_18 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_18]
set cycle_hi_data_18 [get_property DATA [get_hw_axi_txns cycle_hi_18]]
scan $cycle_hi_data_18 %x cycle_hi_18

# Read instret_lo
create_hw_axi_txn instret_lo_18 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_18]
set instret_lo_data_18 [get_property DATA [get_hw_axi_txns instret_lo_18]]
scan $instret_lo_data_18 %x instret_lo_18

# Read instret_hi
create_hw_axi_txn instret_hi_18 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_18]
set instret_hi_data_18 [get_property DATA [get_hw_axi_txns instret_hi_18]]
scan $instret_hi_data_18 %x instret_hi_18

# Combine 32-bit halves into 64-bit values
set cycles_18 [expr {($cycle_hi_18 << 32) | $cycle_lo_18}]
set instret_18 [expr {($instret_hi_18 << 32) | $instret_lo_18}]

puts "TEST: wikisort"
puts "  cycles  = $cycles_18"
puts "  instret = $instret_18"
puts $result_fp "wikisort,$cycle_lo_18,$cycle_hi_18,$cycles_18,$instret_lo_18,$instret_hi_18,$instret_18,0"
flush $result_fp

# Put CPU back into reset before next test
create_hw_axi_txn final_reset_18 $hw_axi -type WRITE -address C0000014 -data 00000000
run_axi_delayed final_reset_18

