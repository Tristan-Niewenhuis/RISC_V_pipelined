create_hw_axi_txn release_cpu_7 $hw_axi -type WRITE -address C0000014 -data 00000001
run_axi_delayed release_cpu_7

# Poll STATUS until DONE = 1
set done_7 0
set poll_start_7 [clock seconds]
create_hw_axi_txn status_7 $hw_axi -type READ -address C0000010
while {!$done_7} {
    run_hw_axi [get_hw_axi_txns status_7]
    set status_data_7 [get_property DATA [get_hw_axi_txns status_7]]
    scan $status_data_7 %x status_value_7
    if {($status_value_7 & 1) != 0} {
        set done_7 1
    }
    if {[expr {[clock seconds] - $poll_start_7}] >= 60} {
        puts "ERROR: Timeout waiting for DONE on md5sum"
        puts $result_fp "md5sum,TIMEOUT"
        flush $result_fp
        close $result_fp
        close_hw_target
        disconnect_hw_server
        close_hw_manager
        exit 1
    }
    after 250
}

# Read cycle_lo
create_hw_axi_txn cycle_lo_7 $hw_axi -type READ -address C0000000
run_hw_axi [get_hw_axi_txns cycle_lo_7]
set cycle_lo_data_7 [get_property DATA [get_hw_axi_txns cycle_lo_7]]
scan $cycle_lo_data_7 %x cycle_lo_7

# Read cycle_hi
create_hw_axi_txn cycle_hi_7 $hw_axi -type READ -address C0000004
run_hw_axi [get_hw_axi_txns cycle_hi_7]
set cycle_hi_data_7 [get_property DATA [get_hw_axi_txns cycle_hi_7]]
scan $cycle_hi_data_7 %x cycle_hi_7

# Read instret_lo
create_hw_axi_txn instret_lo_7 $hw_axi -type READ -address C0000008
run_hw_axi [get_hw_axi_txns instret_lo_7]
set instret_lo_data_7 [get_property DATA [get_hw_axi_txns instret_lo_7]]
scan $instret_lo_data_7 %x instret_lo_7

# Read instret_hi
create_hw_axi_txn instret_hi_7 $hw_axi -type READ -address C000000C
run_hw_axi [get_hw_axi_txns instret_hi_7]
set instret_hi_data_7 [get_property DATA [get_hw_axi_txns instret_hi_7]]
scan $instret_hi_data_7 %x instret_hi_7

# Combine 32-bit halves into 64-bit values
set cycles_7 [expr {($cycle_hi_7 << 32) | $cycle_lo_7}]
set instret_7 [expr {($instret_hi_7 << 32) | $instret_lo_7}]

puts "TEST: md5sum"
puts "  cycles  = $cycles_7"
puts "  instret = $instret_7"
puts $result_fp "md5sum,$cycle_lo_7,$cycle_hi_7,$cycles_7,$instret_lo_7,$instret_hi_7,$instret_7,0"
flush $result_fp

# Put CPU back into reset before next test
create_hw_axi_txn final_reset_7 $hw_axi -type WRITE -address C0000014 -data 00000000
run_axi_delayed final_reset_7

